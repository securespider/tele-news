# ==============================================================================
# Telegram Bot & Organization Access Control
# ==============================================================================
# Required: Bot token obtained from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Organization display name shown in digests, exports, and onboarding
ORG_NAME=DailyAI Research

# Comma-separated numeric Telegram user IDs for organization Admins and Members.
# Admins can create invite codes (/admin invite), manage users, and edit RSS feeds.
TELEGRAM_ADMIN_IDS=
TELEGRAM_ALLOWED_USER_IDS=

# Legacy single-user chat ID restriction (optional; automatically mapped to admin)
TELEGRAM_ALLOWED_CHAT_ID=

# If true and no admins are configured yet, the first private DM /start user becomes Admin.
# Set to false in production after your first admin is registered or listed in TELEGRAM_ADMIN_IDS.
ALLOW_SELF_REGISTER_FIRST_ADMIN=true

# ==============================================================================
# LLM Configuration (OpenAI Codex CLI or OpenAI-Compatible API)
# ==============================================================================
# Supported providers:
#   codex:  Uses local Codex CLI OAuth (~/.codex/auth.json), no API key or local model needed.
#           Set LLM_PROVIDER=codex, LLM_MODEL=gpt-6-luna, CODEX_REASONING_EFFORT=low
#   openai: Works with OpenAI, Google Gemini (OpenAI-compat endpoint), OpenRouter, or vLLM.
LLM_PROVIDER=openai
LLM_API_KEY=your_llm_api_key_here
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=45
LLM_MAX_CONCURRENCY=4
CODEX_CLI_PATH=
CODEX_REASONING_EFFORT=low

# ==============================================================================
# RSS Feeds & Academic Paper Sources
# ==============================================================================
# Seeded into SQLite on startup; admins can also manage feeds live with /feeds.
RSS_FEEDS=https://hnrss.org/frontpage,https://techcrunch.com/category/artificial-intelligence/feed/,https://simonwillison.net/atom/everything/,https://huggingface.co/blog/feed.xml,https://openai.com/news/rss.xml,https://rss.arxiv.org/rss/cs.AI+cs.LG+cs.CL

# Ingest Hugging Face Daily Papers (free JSON API) and query arXiv / Semantic Scholar
ENABLE_HF_DAILY_PAPERS=true
ENABLE_ARXIV_API=true
ARXIV_CATEGORIES=cs.AI,cs.LG,cs.CL,cs.CV
# Optional free API key from semanticscholar.org for dedicated 1 RPS quota
SEMANTIC_SCHOLAR_API_KEY=

# ==============================================================================
# Scheduling, Relevance, Rate Limits & Storage
# ==============================================================================
SCRAPE_INTERVAL_MINUTES=30
DIGEST_INTERVAL_HOURS=4
DIGEST_TICK_MINUTES=15
MAX_ARTICLES_PER_DIGEST=5
MIN_RELEVANCE_SCORE=0.65
MAX_ARTICLE_AGE_HOURS=72
MAX_ENTRIES_PER_FEED=30
DISCOVERY_POLL_EVERY_N_DIGESTS=3
DEFAULT_DIGEST_MODE=balanced
# Auto-disable a feed after N consecutive fetch/parse failures (0 disables)
FEED_MAX_CONSECUTIVE_FAILURES=5
# Prune expired/filtered_out/failed articles older than N days (0 disables)
ARTICLE_RETENTION_DAYS=30
# Optional default local quiet hours window in 24h HH-HH format (e.g., 23-07). Blank disables.
QUIET_HOURS=

# Cyber-hardening rate limits & org-wide daily LLM call budget
RATE_LIMIT_COMMANDS_PER_MIN=20
RATE_LIMIT_LLM_PER_USER_HOUR=12
DAILY_ORG_LLM_BUDGET=500

LOG_LEVEL=INFO
DB_PATH=data/daily_ai.db
